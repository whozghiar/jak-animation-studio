{
  "name": "opengoal-animation-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check:retarget": "node --experimental-strip-types --no-warnings src/lib/retarget.check.ts",
    "check:variants": "node --experimental-strip-types --no-warnings src/lib/variants.check.ts",
    "check:keys": "node --experimental-strip-types --no-warnings src/lib/keys.check.ts",
    "check-format": "npx prettier --plugin prettier-plugin-svelte --check .",
    "format": "npx prettier --plugin prettier-plugin-svelte --write . && cargo fmt --all",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "skills:link": "node ./scripts/link-skills.mjs"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.3.3",
    "@types/three": "^0.180.0",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "1.31.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.53.6",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "three": "^0.180.0"
  },
  "packageManager": "yarn@1.22.19"
}
